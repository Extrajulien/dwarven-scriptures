DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Secret used to sign session cookies (generate with: openssl rand -base64 32)
SESSION_SECRET="change-me"
# Comma-separated origins allowed to open a WebSocket to /ws (TECH-06, ADR-010).
# Same-origin (the request's Host header) is ALWAYS accepted; this allowlist is
# merged on top of it. Set the public origin in production so browsers coming
# through the Railway proxy are admitted:
# WS_ALLOWED_ORIGINS="https://dwarven-scriptures.up.railway.app"
WS_ALLOWED_ORIGINS=""
# Optional client-side override of the socket URL (default: same origin, /ws).
# Only needed if the realtime layer is ever split into its own process (ADR-010
# chose the single-process custom server, so leave this empty).
NEXT_PUBLIC_WS_URL=""
# Port and bind address of the custom server (dev + production share one process).
# PORT must be a number 1-65535 (default 3000); HOSTNAME must be an IP literal
# (default "::" — all interfaces, IPv4 + IPv6 dual-stack, which is what the
# Railway edge proxy requires). Hostnames are ignored on purpose.
PORT="3000"
HOSTNAME="::"
# OAuth client credentials (GitHub OAuth App, callback: /api/auth/github/callback)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# OAuth client credentials (Discord application, callback: /api/auth/discord/callback)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
